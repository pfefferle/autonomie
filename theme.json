              "fontWeight": "300",
              "fontStyle": "italic",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/font/merriweather/merriweather-v15-latin-300italic.woff2"
              ]
            },
            {
              "fontFamily": "Merriweather",
              "fontWeight": "500",
              "fontStyle": "normal",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/font/merriweather/merriweather-v33-latin-variable.woff2"
              ]
            },
            {
              "fontFamily": "Merriweather",
              "fontWeight": "600",
              "fontStyle": "normal",
