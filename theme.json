      "core/post-author": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--sans-serif)",
          "fontSize": "var(--wp--custom--meta--font-size)",
          "lineHeight": "var(--wp--custom--meta--line-height)",
          "fontWeight": "var(--wp--custom--meta--font-weight)"
        },
        "color": {
          "text": "var(--wp--preset--color--light-gray)"
        },
        "elements": {
          "link": {
            "color": {
              "text": "var(--wp--preset--color--light-gray)"
            },
            "typography": {
              "fontWeight": "var(--wp--custom--meta--font-weight)",
              "textDecoration": "none"
            },
            ":hover": {
              "color": {
                "text": "var(--wp--preset--color--primary)"
              },
              "typography": {
                "textDecoration": "underline"
              }
            }
          }
        }
      },
      "core/post-terms": {
