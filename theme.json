        {
          "name": "Small",
          "slug": "small",
          "size": "0.8rem",
          "fluid": false
        },
        {
          "name": "Medium",
          "slug": "medium",
          "size": "1.2rem",
          "fluid": false
        },
        {
          "name": "Large",
          "slug": "large",
          "size": "1.5rem",
          "fluid": false
        },
        {
          "name": "Extra Large",
          "slug": "x-large",
          "size": "1.8rem",
          "fluid": false
        },
        {
          "name": "Huge",
          "slug": "huge",
          "size": "2.4rem",
          "fluid": {
            "min": "2rem",
            "max": "2.4rem"
          }
        }
      ],
      "fontFamilies": [
        {
          "fontFamily": "Lato, sans-serif",
          "name": "Lato",
          "slug": "sans-serif",
          "fontFace": [
            {
              "fontFamily": "Lato",
              "fontWeight": "300",
              "fontStyle": "normal",
              "fontDisplay": "swap",
              "src": ["file:./assets/font/lato/lato-v13-latin-300.woff2"]
            },
            {
              "fontFamily": "Lato",
              "fontWeight": "300",
              "fontStyle": "italic",
              "fontDisplay": "swap",
