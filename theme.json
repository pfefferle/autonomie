{
  "$schema": "https:\/\/schemas.wp.org\/trunk\/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "color": {
      "palette": [
        {
          "name": "Primary",
          "slug": "primary",
          "color": "#0073aa"
        },
        {
          "name": "Secondary",
          "slug": "secondary",
          "color": "#767676"
        },
        {
          "name": "Background",
          "slug": "background",
          "color": "#ffffff"
        },
        {
          "name": "Text",
          "slug": "text",
          "color": "#333333"
        },
        {
          "name": "Light Gray",
          "slug": "light-gray",
          "color": "#f5f5f5"
        },
        {
          "name": "Blue",
          "slug": "blue",
          "color": "#0073aa"
        },
        {
          "name": "Lighter Blue",
          "slug": "lighter-blue",
          "color": "#229fd8"
        },
        {
          "name": "Blue Jeans",
          "slug": "blue-jeans",
          "color": "#5bc0eb"
        },
        {
          "name": "Orioles Orange",
          "slug": "orioles-orange",
          "color": "#fa5b0f"
        },
        {
          "name": "USC Gold",
          "slug": "usc-gold",
          "color": "#ffcc00"
        },
        {
          "name": "Gargoyle Gas",
          "slug": "gargoyle-gas",
          "color": "#fde74c"
        },
        {
          "name": "Yellow",
          "slug": "yellow",
          "color": "#fff9c0"
        },
        {
          "name": "Android Green",
          "slug": "android-green",
          "color": "#9bc53d"
        },
        {
          "name": "White",
          "slug": "white",
          "color": "#fff"
        },
        {
          "name": "Black",
          "slug": "black",
          "color": "#000"
        },
        {
          "name": "Dark Gray",
          "slug": "dark-gray",
          "color": "#444"
        },
        {
          "name": "White",
          "slug": "white",
          "color": "#fff"
        },
        {
          "name": "Very light gray",
          "slug": "very-light-gray",
          "color": "#eee"
        },
        {
          "name": "Very dark gray",
          "slug": "very-dark-gray",
          "color": "#444"
        }
      ],
      "gradients": [
        {
          "name": "Primary to Secondary",
          "slug": "primary-secondary",
          "gradient": "linear-gradient(135deg, #0073aa 0%, #767676 100%)"
        }
      ]
    },
    "layout": {
        "contentSize": "700px",
        "wideSize": "1200px"
    },
    "spacing": {
      "padding": true,
      "margin": true,
      "units": ["px", "em", "rem", "%", "vw", "vh"],
      "spacingSizes": [
        {
          "name": "Small",
          "slug": "small",
          "size": "1rem"
        },
        {
          "name": "Medium",
          "slug": "medium",
          "size": "2rem"
        },
        {
          "name": "Large",
          "slug": "large",
          "size": "3rem"
        }
      ]
    },
    "typography": {
      "fluid": true,
      "fontSizes": [
        {
          "name": "meta",
          "slug": "meta",
          "size": "1em"
        }
      ],
      "fontFamilies": [
        {
          "fontFamily": "Lato, sans serif",
          "name": "Lato",
          "slug": "sans-serif",
          "fontFace": [
            {
              "fontFamily": "Lato Light",
              "fontWeight": "normal",
              "fontStyle": "normal",
              "fontStretch": "normal",
              "fontDisplay": "swap",
              "src": [ "file:./assets/font/lato/lato-v13-latin-300.woff2" ]
            },
            {
              "fontFamily": "Lato Light Italic",
              "fontWeight": "normal",
              "fontStyle": "italic",
              "fontStretch": "normal",
              "fontDisplay": "swap",
              "src": [ "file:./assets/font/lato/lato-v13-latin-300italic.woff2" ]
            },
            {
              "fontFamily": "Lato Bold",
              "fontWeight": "bold",
              "fontStyle": "normal",
              "fontStretch": "normal",
              "fontDisplay": "swap",
              "src": [ "file:./assets/font/lato/lato-v13-latin-700.woff2" ]
            },
            {
              "fontFamily": "Lato Bold Italic",
              "fontWeight": "bold",
              "fontStyle": "italic",
              "fontStretch": "normal",
              "fontDisplay": "swap",
              "src": [ "file:./assets/font/lato/lato-v13-latin-700italic.woff2" ]
            }
          ]
        },
        {
          "fontFamily": "Merriweather, serif",
          "name": "Merriweather",
          "slug": "serif",
          "fontFace": [
            {
              "fontFamily": "Merriweather Light",
              "fontWeight": "normal",
              "fontStyle": "normal",
              "fontStretch": "normal",
              "fontDisplay": "swap",
              "src": [ "file:./assets/font/merriweather/merriweather-v15-latin-300.woff2" ]
            },
            {
              "fontFamily": "Merriweather Light Italic",
              "fontWeight": "normal",
              "fontStyle": "italic",
              "fontStretch": "normal",
              "fontDisplay": "swap",
              "src": [ "file:./assets/font/merriweather/merriweather-v15-latin-300italic.woff2" ]
            },
            {
              "fontFamily": "Merriweather Bold Italic",
              "fontWeight": "bold",
              "fontStyle": "italic",
              "fontStretch": "normal",
              "fontDisplay": "swap",
              "src": [ "file:./assets/font/merriweather/merriweather-v15-latin-700italic.woff2" ]
            },
            {
              "fontFamily": "Merriweather Bold",
              "fontWeight": "bold",
              "fontStyle": "normal",
              "fontStretch": "normal",
              "fontDisplay": "swap",
              "src": [ "file:./assets/font/merriweather/merriweather-v15-latin-700.woff2" ]
            }
          ]
        }
      ]
    },
    "custom": {
      "navigation": {
        "overlay": false,
        "style": {
          "spacing": {
            "padding": {
              "top": "1rem",
              "bottom": "1rem"
            }
          }
        }
      }
    }
  },
  "styles": {
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--sans-serif)",
      "fontSize": "var(--wp--preset--font-size--medium)",
      "lineHeight": "1.5"
    },
    "color": {
      "background": "var(--wp--preset--color--background)",
      "text": "var(--wp--preset--color--text)"
    },
    "spacing": {
      "padding": {
        "top": "1rem",
        "right": "2rem",
        "bottom": "1rem",
        "left": "2rem"
      },
      "margin": {
        "top": "0",
        "bottom": "2rem"
      }
    },
    "elements": {
      "h1" : {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--serif)",
          "fontWeight": "normal"
        }
      },
      "h2" : {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--serif)",
          "fontWeight": "normal"
        }
      },
      "link": {
        "color": {
          "text": "var(--wp--preset--color--dark-gray)"
        },
        ":hover": {
          "typography": {
            "textDecoration": "none"
          }
        }
      }
    },
    "blocks": {
      "core/heading": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--serif)",
          "fontWeight": "normal"
        }
      },
      "core/quote": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--serif)",
          "fontWeight": "normal"
        },
        "spacing": {
          "padding": {
            "left": "2rem",
            "top": "0.5rem",
            "bottom": "0.5rem"
          }
        },
        "border": {
          "left": {
            "style": "solid",
            "color": "var(--wp--preset--color--dark-gray)",
            "width": "3px"
          }
        }
      },
      "core/pullquote": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--serif)",
          "fontWeight": "normal"
        },
        "dimensions": {
          "maxWidth": "var(--wp--style--global--wide-size)"
        },
        "spacing": {
          "margin": {
            "left": "auto",
            "right": "auto"
          }
        }
      },
      "core/paragraph": {
        "spacing": {
          "margin": {
            "top": "2rem",
            "bottom": "2rem",
            "left": "auto",
            "right": "auto"
          }
        },
        "dimensions": {
          "maxWidth": "var(--wp--style--global--content-size)"
        },
        "elements": {
          "link": {
            "color": {
              "text": "var(--wp--preset--color--primary)"
            }
          }
        }
      },
      "core/button": {
        "color": {
          "background": "var(--wp--preset--color--primary)",
          "text": "var(--wp--preset--color--background)"
        },
        "typography": {
          "fontSize": "1rem",
          "fontWeight": "bold"
        },
        "spacing": {
          "padding": {
            "top": "0.5rem",
            "right": "1rem",
            "bottom": "0.5rem",
            "left": "1rem"
          }
        },
        "border": {
          "radius": "4px"
        }
      },
      "core/navigation": {
        "typography": {
          "fontSize": "1rem",
          "fontFamily": "var(--wp--preset--font-family--sans-serif)"
        },
        "color": {
          "text": "var(--wp--preset--color--text)"
        },
        "elements": {
          "link": {
            ":hover": {
              "color": {
                "text": "var(--wp--preset--color--primary)"
              }
            }
          }
        }
      }
    }
  }
}
