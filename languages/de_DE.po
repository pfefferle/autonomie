#. Theme Name of the theme
#: style.css
msgid "Autonomie"
msgstr "Autonomie"

#. Theme URI of the theme
#: style.css
msgid "https://github.com/pfefferle/Autonomie"
msgstr "https://github.com/pfefferle/Autonomie"

#. Description of the theme
#: style.css
msgid "Autonomie is a highly semantic, responsive, accessible and SEO-optimized Full Site Editing (FSE) WordPress theme. It provides HTML5 templates refined with microformats, microformats v2 and microdata (Schema.org). Autonomie supports the IndieWeb and is fully compatible with modern block-based editing."
msgstr "Autonomie ist ein sehr semantisches, responsives, barrierearmes und suchmaschinenfreundliches Full-Site-Editing-Theme (FSE) für WordPress. Es liefert HTML5-Templates mit Microformats, Microformats v2 und Microdata (Schema.org). Autonomie unterstützt das IndieWeb und ist voll kompatibel mit dem blockbasierten Bearbeiten."

#. Author of the theme
#: style.css
msgid "Matthias Pfefferle"
msgstr "Matthias Pfefferle"

#. Author URI of the theme
#: style.css
msgid "https://notiz.blog/"
msgstr "https://notiz.blog/"

